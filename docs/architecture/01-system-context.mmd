flowchart LR
    organiser["Event Organiser<br/>[Person]"]
    coordinator["Event Coordinator<br/>[Person]"]
    venueStaff["Venue Staff<br/>[Person]"]
    technical["Technical Support Staff<br/>[Person]"]
